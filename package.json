{
  "name": "sketch2ui",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w packages/shared-types && npm run build -w packages/codegen && npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck -w packages/shared-types && npm run typecheck -w packages/codegen && npm run typecheck -w backend && npm run typecheck -w frontend && npm run typecheck -w scripts",
    "check:db-state": "tsx scripts/src/check-db-state-usage.ts",
    "test": "npm run test -w packages/shared-types && npm run test -w backend",
    "test:py": "cd cv-service && .venv/bin/python -m pytest -q",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:import-json": "npm run db:import-json -w backend",
    "admin:promote": "npm run admin:promote -w backend",
    "dataset:export": "tsx scripts/src/export-yolo-dataset.ts",
    "dataset:import": "tsx scripts/src/import-external-datasets.ts",
    "dataset:build-v1": "tsx scripts/src/build-v1-subset.ts",
    "dataset:report": "tsx scripts/src/dataset-quality-report.ts",
    "model:eval": "tsx scripts/src/evaluate.ts",
    "model:active-learning": "tsx scripts/src/active-learning-report.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
