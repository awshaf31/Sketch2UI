{
  "name": "sketch2ui",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w packages/shared-types && npm run build -w packages/codegen && npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck -w backend && npm run typecheck -w scripts",
    "export:dataset": "tsx scripts/src/export-yolo-dataset.ts",
    "import:external": "tsx scripts/src/import-external-datasets.ts",
    "build:v1": "tsx scripts/src/build-v1-subset.ts",
    "report:active-learning": "tsx scripts/src/active-learning-report.ts",
    "report:dataset-quality": "tsx scripts/src/dataset-quality-report.ts",
    "eval": "tsx scripts/src/evaluate.ts",
    "test": "npm run test -w packages/shared-types && npm run test -w backend",
    "test:py": "cd cv-service && .venv/bin/python -m pytest -q",
    "test:e2e": "playwright test",
    "check:db-state": "tsx scripts/src/check-db-state-usage.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
