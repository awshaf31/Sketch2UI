// Sketch2UI persistence schema — execution plan Phase 8 (§8, Appendix E).
//
// Derived from the ACTUAL current domain models in packages/shared-types/src/*.ts as of
// 2026-08-24, not from the original plan's §8 schema design. Where the two disagree the
// running code wins (execution plan Rule 7 / Appendix E Stage 1: "Do not create a
// database schema based solely on the old proposal if current runtime objects have
// changed"). Every model below maps 1:1 onto a StoreShape array in
// apps/api/src/db/jsonStore.ts.
//
// Three deliberate design decisions are documented at their definitions:
//   1. the four inspector override maps are NORMALIZED into their own tables
//   2. bbox is FLATTENED into four Float columns
//   3. genuinely-opaque payloads (snapshots, result blobs) stay Json
//
// NOTE: no migration has been applied against a live database yet — see
// docs/execution/phase-log.md, Phase 8 (part 1). This file is validated by
// `prisma validate` and its SQL is generated by `prisma migrate diff`, but the
// Postgres instance available on this machine belongs to an unrelated project.

generator client {
  provider = "prisma-client-js"
  // No custom `output`. This is an npm-workspaces repo, so `@prisma/client` hoists to
  // the ROOT node_modules and resolves its generated types from the root
  // node_modules/.prisma/client. Pointing output at apps/api/node_modules/.prisma/client
  // put the real types somewhere the hoisted package never looks, leaving `PrismaClient`
  // typed as the unpopulated stub — every query returned `any`, which surfaced as
  // implicit-any errors rather than as anything obviously Prisma-related.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — these are string unions in TypeScript today. Making them real database
// enums moves validation that currently lives only in route handlers into the
// storage layer, which is the point of §8.4.
// ---------------------------------------------------------------------------

enum ProjectStatus {
  draft
  annotated
  generated
  archived
}

enum DetectionSource {
  model
  manual
  imported
}

enum DetectionStatus {
  active
  deleted
  rejected
}

enum CodeVersionSource {
  generated
  edited
}

enum JobType {
  detect
  layout
  codegen
  export
}

enum JobStatus {
  queued
  processing
  completed
  failed
}

enum JobStage {
  queued
  preprocessing
  component_detection
  persisting_detections
  completed
  failed
}

enum DatasetSplit {
  train
  val
  test
}

enum PageBoundaryMethod {
  contour
  none
  manual
}

enum PageBoundarySource {
  auto
  manual
}

enum ContentState {
  known
  unknown
  user_edited // "user-edited" in TS; hyphen is not a legal enum member here
}

enum CorrectionType {
  created
  deleted
  class_changed
  bbox_changed
  parent_changed
  order_changed
  ignored
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  /// Reserved for future RBAC — no route reads this yet in Phase D1.
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  /// sha256(cookie token) — the raw token is never stored, same reasoning as a
  /// password hash: a database read/leak must not hand out a usable bearer token.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Project {
  id          String        @id
  name        String
  description String?
  status      ProjectStatus @default(draft)
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id])

  /// Which CodeVersion preview and export use. Unset means "the latest".
  /// Deliberately NOT a Prisma relation: CodeVersion already points at Project, and
  /// adding the reverse relation creates a cycle that forces one side to be created
  /// before the other can reference it. Kept as a plain nullable id with an index,
  /// matching how the JSON store treats it. Referential correctness is enforced by
  /// the activate route, which only ever sets an id it has just looked up.
  activeCodeVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages              Page[]
  assets             ProjectAsset[]
  detections         Detection[]
  codeVersions       CodeVersion[]
  jobs               Job[]
  trainingSamples    TrainingSample[]
  exports            ProjectExport[]
  pageBoundaries     PageBoundaryRecord[]
  correctionRecords  CorrectionRecord[]
  styleOverrides     StyleOverride[]
  contentOverrides   ContentOverride[]
  geometryOverrides  GeometryOverride[]
  structureOverrides StructureOverride[]

  @@index([activeCodeVersionId])
  @@index([ownerId])
  @@map("projects")
}

/// Phase D3 minimum-viable multi-page. A Page owns one source asset, its
/// detections, boundary, the four override groups, corrections, and code
/// versions — see packages/shared-types/src/page.ts. Every existing project gets
/// exactly one Page ("Page 1") via an automatic JSON-store backfill or the
/// explicit apps/api/scripts/backfill-pages.ts for Postgres.
model Page {
  id      String @id @default(uuid())
  projectId String
  name    String
  /// Sort position, and the export filename suffix (order 1 -> index.html,
  /// order N -> page-N.html).
  order   Int

  /// Same NOT-a-relation pattern as Project.activeCodeVersionId, and for the
  /// same reason (avoids a CodeVersion <-> Page creation cycle).
  activeCodeVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assets             ProjectAsset[]
  detections         Detection[]
  codeVersions       CodeVersion[]
  jobs               Job[]
  pageBoundaries     PageBoundaryRecord[]
  correctionRecords  CorrectionRecord[]
  styleOverrides     StyleOverride[]
  contentOverrides   ContentOverride[]
  geometryOverrides  GeometryOverride[]
  structureOverrides StructureOverride[]

  @@unique([projectId, order])
  @@index([activeCodeVersionId])
  @@map("pages")
}

model ProjectAsset {
  id        String @id
  projectId String
  pageId    String
  /// Filename under data/uploads/ — the storage convention, not a filesystem path.
  storageKey String
  mimeType   String
  width      Int
  height     Int
  fileSize   Int
  createdAt  DateTime @default(now())

  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page           Page                 @relation(fields: [pageId], references: [id], onDelete: Cascade)
  detections     Detection[]
  jobs           Job[]
  trainingSample TrainingSample?
  pageBoundary   PageBoundaryRecord?

  @@index([projectId])
  @@index([pageId])
  @@map("project_assets")
}

model Detection {
  id            String @id
  projectId     String
  pageId        String
  sourceAssetId String
  className     String

  /// 1.0 for manual annotations; the model's score otherwise.
  confidence Float

  /// BBox FLATTENED from the TS `{ x, y, width, height }` object.
  ///
  /// Kept as four Float columns rather than one Json blob because these are the most
  /// queried values in the system (page-boundary filtering, layout containment, crop
  /// generation) and because flat columns can carry real CHECK constraints on the
  /// normalized [0,1] invariant — an invariant currently enforced only in
  /// validateGeometryOverride() on the write path. Json would make both impossible.
  bboxX      Float
  bboxY      Float
  bboxWidth  Float
  bboxHeight Float

  status DetectionStatus @default(active)
  source DetectionSource

  modelVersionId String?
  /// The class the MODEL originally proposed, recorded when a human corrects a
  /// model-sourced detection (§36's active-learning signal).
  originalClassName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page        Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sourceAsset ProjectAsset @relation(fields: [sourceAssetId], references: [id], onDelete: Cascade)

  styleOverride     StyleOverride?
  contentOverride   ContentOverride?
  geometryOverride  GeometryOverride?
  structureOverride StructureOverride?
  correctionRecords CorrectionRecord[]

  /// Structure overrides that name THIS detection as their parent. The inverse side of
  /// StructureOverride.parent — this is what turns "parent must exist" from an app-level
  /// check in validateStructureOverride() into a database guarantee.
  childStructureOverrides StructureOverride[] @relation("StructureParent")

  @@index([projectId])
  @@index([pageId])
  @@index([sourceAssetId])
  @@index([projectId, status])
  @@index([pageId, status])
  @@map("detections")
}

model CodeVersion {
  id            String            @id
  projectId     String
  pageId        String
  versionNumber Int
  source        CodeVersionSource
  html          String
  css           String
  javascript    String?

  /// §8.7 metadata_json. Carries `assets`: relative image path -> detection id, so an
  /// export built from this immutable version can regenerate the right crops later.
  /// Genuinely opaque to the database — never filtered on, always read whole.
  metadata Json?

  createdAt DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page    Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  exports ProjectExport[]

  /// Version numbers are per-PAGE (Phase D3) and assigned as `existing.length + 1`.
  /// A unique constraint turns that into a real guarantee — under concurrent writes
  /// the JSON store could hand out the same number twice, which is exactly the
  /// class of bug §8.3 wants transactions for.
  @@unique([pageId, versionNumber])
  @@index([projectId])
  @@index([pageId])
  @@map("code_versions")
}

model Job {
  id            String    @id
  projectId     String
  /// Optional, mirroring sourceAssetId's optionality: a detect/codegen job is
  /// page-scoped, a hypothetical whole-project export job would not be.
  pageId        String?
  type          JobType
  status        JobStatus
  stage         JobStage
  progress      Int       @default(0)
  sourceAssetId String?

  errorCode    String?
  errorMessage String?
  retryable    Boolean?

  detectionCount Int?
  modelVersionId String?

  /// §10 result payload: the boundary this run found. Read as a whole, never queried
  /// by field — Json is the honest representation.
  pageBoundary  Json?
  rejectedCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page        Page?         @relation(fields: [pageId], references: [id], onDelete: SetNull)
  sourceAsset ProjectAsset? @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([pageId])
  @@index([status])
  @@map("jobs")
}

model TrainingSample {
  id           String @id
  projectId    String
  imageAssetId String
  storageKey   String

  approved     Boolean
  approvedAt   DateTime
  datasetSplit DatasetSplit

  /// Frozen snapshot of the approved boxes (TrainingSampleBox[]).
  ///
  /// Json rather than a child table on purpose: this is an immutable record of what a
  /// human signed off on at one instant, always written and read as a single unit and
  /// never queried per-box. Normalizing it would invite exactly the per-row edits the
  /// snapshot exists to prevent (see training-sample.ts: "later edits must not silently
  /// rewrite what a human already signed off on").
  boxes Json

  imageWidth  Int
  imageHeight Int
  createdAt   DateTime @default(now())

  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageAsset ProjectAsset @relation(fields: [imageAssetId], references: [id], onDelete: Cascade)

  /// Re-approving supersedes the previous snapshot rather than stacking duplicates —
  /// training.routes.ts implements this by find-then-splice. The unique constraint makes
  /// it structural instead of procedural.
  @@unique([imageAssetId])
  @@index([projectId])
  @@map("training_samples")
}

model ProjectExport {
  id            String @id
  projectId     String
  codeVersionId String
  versionNumber Int
  storagePath   String
  fileSize      Int
  createdAt     DateTime @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codeVersion CodeVersion @relation(fields: [codeVersionId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("project_exports")
}

model PageBoundaryRecord {
  id        String @id
  projectId String
  pageId    String
  assetId   String

  /// PagePolygon = [x, y][] — an ordered coordinate list. Json is correct here: it is a
  /// variable-length geometric value read as a whole, and Postgres arrays-of-arrays
  /// would not buy anything the application can use.
  polygon Json

  confidence       Float
  method           PageBoundaryMethod
  areaFraction     Float
  applied          Boolean
  overlapThreshold Float?

  /// "manual" marks a user adjustment; auto-detection refuses to overwrite it
  /// (the sticky-correction rule in page-boundary-record.ts).
  source PageBoundarySource

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page    Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  asset   ProjectAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// "One boundary per asset — this is the key" (page-boundary-record.ts).
  @@unique([assetId])
  @@index([projectId])
  @@index([pageId])
  @@map("page_boundaries")
}

model CorrectionRecord {
  id          String         @id
  projectId   String
  pageId      String
  detectionId String
  type        CorrectionType

  /// Always "user" today — there is no automated correction pipeline. Kept as a column
  /// rather than assumed so a future automated path has somewhere to record itself.
  source String @default("user")

  timestamp DateTime
  reason    String?

  oldClassName String?
  newClassName String?

  oldBBoxX      Float?
  oldBBoxY      Float?
  oldBBoxWidth  Float?
  oldBBoxHeight Float?
  newBBoxX      Float?
  newBBoxY      Float?
  newBBoxWidth  Float?
  newBBoxHeight Float?

  /// Null is meaningful here (= "root"), and so is absent (= "no parent override").
  /// Postgres cannot distinguish those two in one nullable column, so `*Set` booleans
  /// carry the distinction the TS type expresses with `null` vs `undefined`.
  oldParentDetectionId    String?
  oldParentDetectionIdSet Boolean @default(false)
  newParentDetectionId    String?
  newParentDetectionIdSet Boolean @default(false)

  oldDisplayOrder Int?
  newDisplayOrder Int?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// Cascade: a correction record describes an edit to a detection. If the detection is
  /// hard-deleted the record loses its subject. This mirrors the current JSON behaviour,
  /// where deleting a detection leaves orphaned records that listCorrections() filters
  /// out by projectId anyway.
  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([pageId])
  @@index([detectionId])
  @@index([projectId, timestamp])
  @@map("correction_records")
}

// ---------------------------------------------------------------------------
// Inspector overrides (§17.3) — NORMALIZED, one table per group.
//
// In the JSON store these are four `Record<detectionId, X>` maps hanging off Project.
// They are normalized here for one specific reason: the plan's §8.4 requires preventing
// "override -> missing detection". As map keys that is unenforceable; as rows with a FK
// to Detection it is a database guarantee, and deleting a detection cleans up its
// overrides automatically instead of leaving orphaned keys behind (which the JSON store
// does today — see the stale-override note in content-overrides.ts).
//
// Each is keyed unique on detectionId: one override per group per detection, which is
// exactly what a `Record<detectionId, X>` expressed.
// ---------------------------------------------------------------------------

model StyleOverride {
  id          String @id @default(uuid())
  projectId   String
  pageId      String
  detectionId String

  /// Record<string, string> over a hard-allowlisted six-property set
  /// (display, gap, padding, margin, font-size, text-align + two alignment props).
  /// Kept as Json because the allowlist is enforced at the API boundary and the value
  /// is emitted verbatim as CSS — columns would fossilize a list that §17.3 may extend.
  style Json

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@unique([detectionId])
  @@index([projectId])
  @@index([pageId])
  @@map("style_overrides")
}

model ContentOverride {
  id          String @id @default(uuid())
  projectId   String
  pageId      String
  detectionId String

  text         String?
  altText      String?
  href         String?
  contentState ContentState @default(user_edited)

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@unique([detectionId])
  @@index([projectId])
  @@index([pageId])
  @@map("content_overrides")
}

model GeometryOverride {
  id          String @id @default(uuid())
  projectId   String
  pageId      String
  detectionId String

  /// All four are optional: a partial override (nudge width only) is legal and inherits
  /// the detection's stored bbox for the rest — see geometry-override.ts's effectiveBBox.
  x      Float?
  y      Float?
  width  Float?
  height Float?

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@unique([detectionId])
  @@index([projectId])
  @@index([pageId])
  @@map("geometry_overrides")
}

model StructureOverride {
  id          String @id @default(uuid())
  projectId   String
  pageId      String
  detectionId String

  /// null = root, absent = keep auto-inferred parent. Same null-vs-undefined problem as
  /// CorrectionRecord's parent columns, solved the same way.
  parentDetectionId    String?
  parentDetectionIdSet Boolean @default(false)

  displayOrder Int?

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  /// The FK that makes validateStructureOverride's "parent must be an active detection"
  /// check structural. SetNull rather than Cascade: if the parent is deleted the child
  /// should fall back to root, not vanish — which is exactly what resolveParent() already
  /// does at render time for a dangling reference.
  parent Detection? @relation("StructureParent", fields: [parentDetectionId], references: [id], onDelete: SetNull)

  @@unique([detectionId])
  @@index([projectId])
  @@index([pageId])
  @@index([parentDetectionId])
  @@map("structure_overrides")
}
