# backend
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
STORE_FILE=./data/store.json

# frontend
VITE_API_URL=http://localhost:4000
# Google Sign-In's public Client ID — safe to expose client-side (no secret is used).
# Both this and the backend's copy below come from the same Google Cloud OAuth client.
# Unset: the Sign-In button just doesn't render (Login/Register still work otherwise).
VITE_GOOGLE_CLIENT_ID=

# Google Sign-In (backend) — backend/src/modules/auth/auth.routes.ts's POST /google
# verifies the ID token against this Client ID. Create one at Google Cloud Console ->
# APIs & Services -> Credentials -> Create OAuth client ID -> Web application, with
# your web app's origin (e.g. http://localhost:5173) as an authorized JavaScript
# origin. Unset: the /google route responds 501 instead of crashing.
GOOGLE_CLIENT_ID=

# Forgot-password email (Resend, resend.com — free tier). Unset: the reset link is
# logged to this server's console instead of emailed, so the flow is still testable
# locally with no account needed.
RESEND_API_KEY=
# Resend's shared, no-setup sender — only delivers to the email address that owns
# your Resend account until you verify a real domain there. Fine for testing.
EMAIL_FROM=onboarding@resend.dev
# Frontend origin the password-reset email link points at.
WEB_URL=http://localhost:5173

# Persistence (Phase 8). PERSISTENCE_DRIVER selects the repository adapter:
#   json     (default) — the legacy file store; still what most modules use
#   postgres           — Prisma; only for domains already migrated
PERSISTENCE_DRIVER=json

# Prisma reads this. Local setup (run once, as a Postgres superuser):
#   CREATE ROLE sketch2ui WITH LOGIN PASSWORD '<your-password>';
#   CREATE DATABASE sketch2ui      OWNER sketch2ui;
#   CREATE DATABASE sketch2ui_test OWNER sketch2ui;   -- repository tests only
# Then: npm run db:migrate -w backend
#
# The test suite rewrites this to <db>_test and refuses to run otherwise, so
# repository tests can never truncate your development data.
DATABASE_URL=postgresql://sketch2ui:<your-password>@localhost:5432/sketch2ui
REDIS_URL=redis://localhost:6379
