node_modules/
dist/
build/
.DS_Store
*.log

# local persistence layer (temporary JSON store, see apps/api/src/db/jsonStore.ts)
apps/api/data/store.json
data/uploads/*
!data/uploads/.gitkeep

# Generated export ZIPs — rebuildable from any stored CodeVersion.
data/exports/

# env
.env
.env.local

# Exported dataset contents. classes.txt and README.md are tracked — classes.txt is
# the machine-independent label contract. images/, labels/ and data.yaml are generated
# by `npm run export:dataset` (data.yaml embeds an absolute path), so they are build
# output and must not be committed.
ml/dataset/images/**/*
ml/dataset/labels/**/*
ml/dataset/data.yaml
!ml/dataset/**/.gitkeep

# v1 training subset — a derived view, fully regenerated by `npm run build:v1`.
# v1-classes.txt and v1-training-scope.md ARE tracked: they are the frozen class
# contract and the documented exclusion rationale.
ml/dataset/v1/
*.cache

# Training environment and run outputs.
ml/training/.venv/
ml/training/runs/

# CV worker environment.
services/cv-worker/.venv/
__pycache__/
.pytest_cache/
*.pyc

# Model registry: weights are large binaries, but the metadata frozen alongside them
# (metrics.json, classes.txt, data.yaml, README.md, diagnostic plots) IS tracked —
# that record is the point of the section 9.10 registry.
ml/models/**/weights.pt
ml/models/*.pt
yolov8*.pt

*.tsbuildinfo
