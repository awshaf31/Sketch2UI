node_modules/
dist/
build/
.DS_Store
*.log

# local persistence layer (temporary JSON store, see backend/src/db/jsonStore.ts)
backend/data/store.json
data/uploads/*
!data/uploads/.gitkeep

# backend/data/ (as opposed to the repo-root data/ above) only ever appears by
# accident: env.ts's defaults resolve to repo-root data/, so anything landing under
# backend/data/ means a process ran with STORE_FILE/UPLOADS_DIR resolved relative to
# a cwd of backend/ instead of the repo root. Ignore the whole directory rather than
# letting that debris get committed piecemeal.
backend/data/

# Generated export ZIPs — rebuildable from any stored CodeVersion.
data/exports/

# env
.env
.env.local

# Exported dataset contents. classes.txt and README.md are tracked — classes.txt is
# the machine-independent label contract. images/, labels/ and data.yaml are generated
# by `npm run export:dataset` (data.yaml embeds an absolute path), so they are build
# output and must not be committed.
ml/dataset/images/**/*
ml/dataset/labels/**/*
ml/dataset/data.yaml
!ml/dataset/**/.gitkeep

# v1 training subset — a derived view, fully regenerated by `npm run build:v1`.
# v1-classes.txt and v1-training-scope.md ARE tracked: they are the frozen class
# contract and the documented exclusion rationale.
ml/dataset/v1/
*.cache

# Training environment and run outputs.
ml/training/.venv/
ml/training/runs/

# CV worker environment.
cv-service/.venv/
__pycache__/
.pytest_cache/
*.pyc

# Model registry: weights are large binaries, but the metadata frozen alongside them
# (metrics.json, classes.txt, data.yaml, README.md, diagnostic plots) IS tracked —
# that record is the point of the section 9.10 registry.
ml/models/**/weights.pt
ml/models/*.pt
yolov8*.pt

*.tsbuildinfo

# Playwright E2E run artifacts — regenerated by `npm run test:e2e`.
/playwright-report/
/test-results/

# Staging area for files pulled out of the project as unnecessary. Nothing here is
# used by the app, the build, or any test — it is kept on disk only so the removal
# stays reversible. Safe to delete outright once confirmed.
dlt/

# Redis dump file, written into whatever cwd redis-server was launched from.
dump.rdb

# Vite's transient esbuild output for vite.config.ts.
*.timestamp-*.mjs
