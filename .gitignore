# ─── Dependencies & build output ──────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
*.cache
.cache/

# Vite's transient esbuild output for vite.config.ts.
*.timestamp-*.mjs


# ─── Environment & secrets ────────────────────────────────────────────────────
# .env.example IS tracked — it is the documented list of every setting.
.env
.env.local
.env.*.local
*.pem
*.key


# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ─── Runtime data ─────────────────────────────────────────────────────────────
# The local JSON store (see backend/src/db/jsonStore.ts) and everything users
# upload or export at runtime. Directory placeholders are kept so a fresh clone
# still has the folder structure the app expects.
backend/data/store.json
data/uploads/*
!data/uploads/.gitkeep

# backend/data/ (as opposed to the repo-root data/ above) only ever appears by
# accident: env.ts's other defaults resolve to repo-root data/, so anything
# landing under backend/data/ means a process ran with STORE_FILE/UPLOADS_DIR
# resolved relative to a cwd of backend/ instead of the repo root. Ignore the
# whole directory rather than letting that debris get committed piecemeal.
backend/data/

# Generated export ZIPs — rebuildable from any stored CodeVersion.
data/exports/

# Redis dump, written into whatever cwd redis-server was launched from.
dump.rdb


# ─── Python (cv-service, ml/training) ─────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/


# ─── ML dataset & models ──────────────────────────────────────────────────────
# Exported dataset contents. classes.txt and README.md are tracked — classes.txt
# is the machine-independent label contract. images/, labels/ and data.yaml are
# generated by `npm run dataset:export` (data.yaml embeds an absolute path), so
# they are build output and must not be committed.
ml/dataset/images/**/*
ml/dataset/labels/**/*
ml/dataset/data.yaml
!ml/dataset/**/.gitkeep

# v1 training subset — a derived view, fully regenerated by
# `npm run dataset:build-v1`. v1-classes.txt and v1-training-scope.md ARE
# tracked: they are the frozen class contract and the exclusion rationale.
ml/dataset/v1/

# Training environment and run outputs.
ml/training/runs/

# Model registry: weights are large binaries, but the metadata frozen alongside
# them (metrics.json, classes.txt, data.yaml, README.md, diagnostic plots) IS
# tracked — that record is the whole point of the registry.
ml/models/**/weights.pt
ml/models/*.pt
yolov8*.pt


# ─── Test artifacts ───────────────────────────────────────────────────────────
# Regenerated by `npm run test:e2e`.
/playwright-report/
/test-results/


# ─── Editors & OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini


# ─── Local tooling ────────────────────────────────────────────────────────────
.claude/
.qodo/

# Staging area for files pulled out of the project as unnecessary. Nothing here
# is used by the app, the build, or any test — it is kept on disk only so the
# removal stays reversible. Safe to delete outright once confirmed.
dlt/
