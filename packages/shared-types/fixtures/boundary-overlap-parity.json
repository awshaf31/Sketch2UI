{
  "$comment": [
    "PARITY CONTRACT for the Sutherland-Hodgman boundary-overlap algorithm.",
    "",
    "The algorithm is implemented TWICE because it must run in two languages:",
    "  services/cv-worker/app/preprocessing/boundary_filter.py  (server-side filtering)",
    "  packages/shared-types/src/boundary-geometry.ts           (instant client re-filter)",
    "",
    "Unlike the split hash — which was de-duplicated in Step 12 by moving it into",
    "shared-types, because both call sites were TypeScript — this one crosses a language",
    "boundary, so real code sharing is not available. This file is the substitute: both",
    "test suites run every case below against their own implementation and assert the",
    "expected value. Drift becomes a failing test instead of a silent divergence.",
    "",
    "If you change either implementation, both suites must still pass. If you change the",
    "intended behaviour, change the expectations here in the same commit."
  ],
  "tolerance": 1e-9,
  "cases": [
    {
      "name": "fully inside",
      "box": [0.1, 0.1, 0.2, 0.2],
      "polygon": [[0, 0], [1, 0], [1, 1], [0, 1]],
      "expected": 1.0
    },
    {
      "name": "fully outside",
      "box": [1.5, 1.5, 0.2, 0.2],
      "polygon": [[0, 0], [1, 0], [1, 1], [0, 1]],
      "expected": 0.0
    },
    {
      "name": "half in on x",
      "box": [0.4, 0.1, 0.2, 0.2],
      "polygon": [[0, 0], [0.5, 0], [0.5, 1], [0, 1]],
      "expected": 0.5
    },
    {
      "name": "quarter in",
      "box": [0.4, 0.1, 0.4, 0.2],
      "polygon": [[0, 0], [0.5, 0], [0.5, 1], [0, 1]],
      "expected": 0.25
    },
    {
      "name": "flush against edge, entirely outside",
      "box": [0.5, 0.1, 0.2, 0.2],
      "polygon": [[0, 0], [0.5, 0], [0.5, 1], [0, 1]],
      "expected": 0.0
    },
    {
      "name": "box exactly equals polygon",
      "box": [0.0, 0.0, 1.0, 1.0],
      "polygon": [[0, 0], [1, 0], [1, 1], [0, 1]],
      "expected": 1.0
    },
    {
      "name": "box larger than polygon",
      "box": [0.0, 0.0, 1.0, 1.0],
      "polygon": [[0, 0], [0.5, 0], [0.5, 1], [0, 1]],
      "expected": 0.5
    },
    {
      "name": "real case: 881ceb2a section straddling the page bottom edge",
      "box": [0.14, 0.94, 0.72, 0.06],
      "polygon": [[0.108, 0.033], [0.9, 0.051], [0.9, 0.952], [0.107, 0.951]],
      "expected": 0.19159310634720664
    },
    {
      "name": "real case: skewed page quad, box inside the skew",
      "box": [0.85, 0.7, 0.12, 0.06],
      "polygon": [[0.05, 0.01], [0.76, 0.03], [0.96, 0.89], [0.05, 0.98]],
      "expected": 0.6065891472868139
    },
    {
      "name": "real case: wide band well inside a skewed quad",
      "box": [0.09, 0.2, 0.66, 0.1],
      "polygon": [[0.052, 0.013], [0.764, 0.029], [0.962, 0.89], [0.052, 0.98]],
      "expected": 1.0
    },
    {
      "name": "single point touching at a corner",
      "box": [0.5, 0.5, 0.25, 0.25],
      "polygon": [[0, 0], [0.5, 0], [0.5, 0.5], [0, 0.5]],
      "expected": 0.0
    },
    {
      "name": "degenerate: zero width",
      "box": [0.2, 0.2, 0.0, 0.3],
      "polygon": [[0, 0], [1, 0], [1, 1], [0, 1]],
      "expected": 0.0
    },
    {
      "name": "degenerate: zero height",
      "box": [0.2, 0.2, 0.3, 0.0],
      "polygon": [[0, 0], [1, 0], [1, 1], [0, 1]],
      "expected": 0.0
    },
    {
      "name": "degenerate: negative width is treated as empty",
      "box": [0.2, 0.2, -0.1, 0.3],
      "polygon": [[0, 0], [1, 0], [1, 1], [0, 1]],
      "expected": 0.0
    },
    {
      "name": "box spans the whole frame, polygon is a small centre square",
      "box": [0.0, 0.0, 1.0, 1.0],
      "polygon": [[0.4, 0.4], [0.6, 0.4], [0.6, 0.6], [0.4, 0.6]],
      "expected": 0.04000000000000001
    },
    {
      "name": "triangle clip polygon, box entirely within the hypotenuse",
      "box": [0.0, 0.0, 0.5, 0.5],
      "polygon": [[0, 0], [1, 0], [0, 1]],
      "expected": 1.0
    },
    {
      "name": "triangle clip polygon, box straddling the hypotenuse",
      "box": [0.4, 0.4, 0.4, 0.4],
      "polygon": [[0, 0], [1, 0], [0, 1]],
      "expected": 0.125
    },
    {
      "name": "clockwise-wound polygon must match its counter-clockwise twin",
      "box": [0.4, 0.1, 0.2, 0.2],
      "polygon": [[0, 1], [0.5, 1], [0.5, 0], [0, 0]],
      "expected": 0.5
    }
  ]
}
