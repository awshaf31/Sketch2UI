{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 4000
    },
    {
      "name": "cv-worker",
      "runtimeExecutable": "services/cv-worker/.venv/bin/uvicorn",
      "runtimeArgs": ["main:app", "--port", "8000", "--app-dir", "services/cv-worker", "--host", "127.0.0.1"],
      "port": 8000
    }
  ]
}
